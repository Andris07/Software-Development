<Window x:Class="LabdarugasGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabdarugasGUI"
        mc:Ignorable="d"
        Title="Labdarúgás feladat" Height="450" Width="600" MinHeight="450" MinWidth="600">
    <DockPanel Margin="20">
        <Label Content="Kérem válasszon tornát:" DockPanel.Dock="Top"/>
        <ComboBox x:Name="cb_torna" DockPanel.Dock="Top" SelectionChanged="cb_torna_SelectionChanged" DisplayMemberPath="Nev"/>

        <Label Content="Kérem válasszon csapatot:" DockPanel.Dock="Top" Margin="0,20,0,0"/>
        <ComboBox x:Name="cb_csapat" IsEnabled="False" DockPanel.Dock="Top" SelectionChanged="cb_csapat_SelectionChanged" DisplayMemberPath="Nev"/>

        <Grid x:Name="grid_adatok" Visibility="Hidden">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="auto" MinHeight="20"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="auto" MinHeight="20"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="auto" MinHeight="20"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="auto" MinHeight="20"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="auto" MinHeight="20"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="auto" MinHeight="20"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="auto" MinHeight="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Label Content="Edző:" Grid.Row="1"/>
            <TextBox x:Name="t_edzonev" IsReadOnly="True" Grid.Row="1" Grid.Column="1"/>

            <Label Content="Tornapontok:" Grid.Row="3"/>
            <TextBox x:Name="t_tornapontok" IsReadOnly="True" Grid.Row="3" Grid.Column="1"/>
            
            <Label Content="Trófeák összesen:" Grid.Row="5"/>
            <TextBox x:Name="t_trofeak" IsReadOnly="True" Grid.Row="5" Grid.Column="1"/>
            <Label Content="db" Grid.Row="5" Grid.Column="2"/>

            <Label Content="Csapattal nyert trófeái:" Grid.Row="7"/>
            <TextBox x:Name="t_edzotrofea" IsReadOnly="True" Grid.Row="7" Grid.Column="1"/>
            <Label Content="db" Grid.Row="7" Grid.Column="2"/>

            <Label Content="Csapatot edzi:" Grid.Row="9"/>
            <TextBox x:Name="t_edzoev" IsReadOnly="True" Grid.Row="9" Grid.Column="1"/>
            <Label Content="éve" Grid.Row="9" Grid.Column="2"/>

            <Label Content="Edző összbevétele:" Grid.Row="11"/>
            <TextBox x:Name="t_edzoosszbevetel" IsReadOnly="True" Grid.Row="11" Grid.Column="1"/>
            <Label Content="Ft" Grid.Row="11" Grid.Column="2"/>
        </Grid>
    </DockPanel>
</Window>
